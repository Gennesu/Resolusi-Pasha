# --- Telegram ---
# Dapatkan token dari @BotFather di Telegram.
TELEGRAM_BOT_TOKEN=

# --- AI (OpenAI-compatible) ---
# Bisa pakai OpenAI, OpenRouter, DeepSeek, Groq, Gemini OpenAI-compat, dst.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Persona / instruksi sistem untuk bot
SYSTEM_PROMPT=You are a helpful assistant for a Telegram user. Reply concisely and accurately.

# Jumlah maksimum pesan (user+assistant) yang diingat per user
HISTORY_LIMIT=20
